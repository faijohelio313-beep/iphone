<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fajio_bg">

    <!-- Encabezado Superior Figma: Inversiones Fajio (Sin ActionBar del sistema) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inversiones Fajio"
            android:textColor="@color/fajio_navy"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Fila 1 Figma: Pestañas Principales (Calculo | Onza (Kitco) | Dolar (bloomberg)) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="#FFFFFF">

            <android.widget.Button
                android:id="@+id/btn_top_calculo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/tab_calculo"
                android:textColor="@color/fajio_navy"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="#FFFFFF"
                android:stateListAnimator="@null" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/fajio_border" />

            <android.widget.Button
                android:id="@+id/btn_top_onza"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="@string/tab_onza"
                android:textColor="@color/fajio_navy"
                android:textSize="12sp"
                android:background="#FFFFFF"
                android:stateListAnimator="@null" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/fajio_border" />

            <android.widget.Button
                android:id="@+id/btn_top_dolar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:text="@string/tab_dolar"
                android:textColor="@color/fajio_navy"
                android:textSize="12sp"
                android:background="#FFFFFF"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/fajio_border" />

        <!-- Fila 2 Figma: Sub-pestañas (Registro | Promedio | Registro Acumulado | Préstamos) -->
        <LinearLayout
            android:id="@+id/layout_subtabs"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="#FFFFFF">

            <android.widget.Button
                android:id="@+id/btn_sub_registro"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/subtab_registro"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@color/fajio_navy"
                android:stateListAnimator="@null" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/fajio_border" />

            <android.widget.Button
                android:id="@+id/btn_sub_promedio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/subtab_promedio"
                android:textColor="@color/fajio_navy"
                android:textSize="12sp"
                android:background="#FFFFFF"
                android:stateListAnimator="@null" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/fajio_border" />

            <android.widget.Button
                android:id="@+id/btn_sub_acumulado"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:text="@string/subtab_acumulado"
                android:textColor="@color/fajio_navy"
                android:textSize="11sp"
                android:background="#FFFFFF"
                android:stateListAnimator="@null" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/fajio_border" />

            <android.widget.Button
                android:id="@+id/btn_sub_prestamos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/subtab_prestamos"
                android:textColor="@color/fajio_navy"
                android:textSize="12sp"
                android:background="#FFFFFF"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/fajio_border" />
    </LinearLayout>

    <!-- Contenedor Principal para Intercambiar Pantallas -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
