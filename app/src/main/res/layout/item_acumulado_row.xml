<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingHorizontal="4dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tv_acum_num"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:text="1"
        android:textColor="@color/fajio_navy"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_acum_onza"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:text="0000"
        android:textColor="@color/fajio_navy"
        android:textSize="11sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_acum_ley"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.1"
        android:text="00.00"
        android:textColor="@color/fajio_navy"
        android:textSize="11sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_acum_pct"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:text="0"
        android:textColor="@color/fajio_navy"
        android:textSize="11sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_acum_peso"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:text="0000"
        android:textColor="@color/fajio_navy"
        android:textSize="11sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_acum_precio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:text="000.00"
        android:textColor="@color/fajio_navy"
        android:textSize="11sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_acum_subtotal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:text="000.00"
        android:textColor="@color/fajio_navy"
        android:textSize="11sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_acum_pagototal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:text="000.00"
        android:textColor="@color/fajio_navy"
        android:textSize="11sp"
        android:gravity="center" />

</LinearLayout>
