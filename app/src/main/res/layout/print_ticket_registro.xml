<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="0dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:paddingLeft="0dp"
    android:paddingRight="0dp"
    android:paddingStart="0dp"
    android:paddingEnd="0dp">

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- LOGO INVERSIONES FAJIO                                    -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="2dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="Logo Inversiones Fajio"
            android:src="@drawable/logo_inversiones_fajio" />
    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- CABECERA VERTICAL: CLIENTE Y FECHA                         -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_marginBottom="3dp">

        <TextView
            android:id="@+id/tv_print_cliente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cliente: Viki"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_print_fecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha: 27/07/2026"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- SEPARADOR PUNTEADO 1 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/print_dashed_line"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp" />

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- SECCIÓN COTIZACIÓN VERTICAL CON LEY Y PORCENTAJE           -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- Onza -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_marginBottom="3dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Onza:"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_print_onza"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4086"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- Ley % -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_marginBottom="3dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ley %:"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_print_ley"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="95.95%"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- Desc % -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_marginBottom="3dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Desc %:"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_print_porcentaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9%"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- TC -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_marginBottom="3dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TC:"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_print_tc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3.365"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- Precio Soles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_marginBottom="3dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Precio Soles:"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_print_precio_soles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S/. 370.48"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- SEPARADOR PUNTEADO 2 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/print_dashed_line"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp" />

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- SECCIÓN PESOS VERTICAL (Sin Fundir, Fundido, Merma)        -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- Sin Fundir -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_marginBottom="3dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sin Fundir:"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_print_peso_sin_fundir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15.3 g"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- Fundido -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_marginBottom="3dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fundido:"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_print_peso_fundido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15.2 g"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- Merma -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_marginBottom="3dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Merma:"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_print_merma"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.1 g"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- SEPARADOR PUNTEADO 3 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/print_dashed_line"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp" />

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- SECCIÓN CÁLCULO Y OPERACIÓN VERTICAL                       -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- Gramos Fundido -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_marginBottom="3dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Gramos Fundido:"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_print_cantidad_fundido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15.2 g"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- Precio Soles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_marginBottom="3dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Precio Soles:"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_print_precio_soles_calc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S/. 370.48"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- Precio Total (Gramos Fundido x Precio Soles) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_marginBottom="3dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PRECIO TOTAL:"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_print_precio_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S/. 5,631.29"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- Descuento -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_marginBottom="3dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Descuento:"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_print_descuento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S/. 0.00"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- SEPARADOR PUNTEADO 4 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/print_dashed_line"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp" />

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- CAJA REDONDEADA DESTACADA: PAGO TOTAL                      -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/print_light_total_bg"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:gravity="center"
        android:layout_marginBottom="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAGO TOTAL"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tv_print_pago_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S/. 5,631.29"
            android:textColor="#000000"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="1dp" />
    </LinearLayout>

</LinearLayout>
