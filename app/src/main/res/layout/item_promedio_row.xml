<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="6dp"
    android:paddingHorizontal="10dp"
    android:gravity="center_vertical"
    android:background="#0F172A"
    android:layout_marginBottom="4dp">

    <TextView
        android:id="@+id/tv_prom_cantidad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:text="1"
        android:textColor="#38BDF8"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center" />

    <EditText
        android:id="@+id/et_prom_pesos"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1.5"
        android:hint="0.0"
        android:textColor="#FFFFFF"
        android:textColorHint="#64748B"
        android:textSize="14sp"
        android:textStyle="bold"
        android:inputType="numberDecimal"
        android:gravity="center"
        android:background="@drawable/fajio_dark_input_bg"
        android:layout_marginHorizontal="4dp"
        android:paddingHorizontal="6dp" />

    <EditText
        android:id="@+id/et_prom_lectura"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1.5"
        android:hint="0.0000"
        android:textColor="#F59E0B"
        android:textColorHint="#64748B"
        android:textSize="14sp"
        android:textStyle="bold"
        android:inputType="numberDecimal"
        android:gravity="center"
        android:background="@drawable/fajio_dark_input_bg"
        android:layout_marginHorizontal="4dp"
        android:paddingHorizontal="6dp" />

    <ImageView
        android:id="@+id/btn_prom_delete_row"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@android:drawable/ic_menu_delete"
        android:contentDescription="Eliminar Fila"
        android:tint="#EF4444"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless" />

</LinearLayout>
